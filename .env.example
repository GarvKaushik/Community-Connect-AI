LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Any OpenAI-compatible chat API. Defaults to Groq; GROQ_API_KEY also works as the key.
LLM_API_KEY=
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=openai/gpt-oss-120b

# Optional: volunteer notifications
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Optional: "small" understands Hindi far better than "base", but is slower on CPU
WHISPER_MODEL=small

# Optional: language for `python agent.py console` (the web page has its own picker)
AGENT_LANGUAGE=en
