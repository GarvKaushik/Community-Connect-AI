LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Any OpenAI-compatible chat API. Defaults to Groq; GROQ_API_KEY also works as the key.
LLM_API_KEY=
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=openai/gpt-oss-120b
# Ollama Cloud runs the same model:
# LLM_BASE_URL=https://ollama.com/v1
# LLM_MODEL=gpt-oss:120b

# Optional: seconds to wait for one model reply in evals (raise to 300 for local Ollama)
# LLM_TIMEOUT=10

# Optional: volunteer notifications
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Optional: speech-to-text model per language. "base" is fast for English; set "small" if
# English scheme names are often misheard. The Hindi model is fine-tuned on Hindi.
WHISPER_MODEL_EN=base
WHISPER_MODEL_HI=collabora/faster-whisper-small-hindi

# Optional: language for `python agent.py console` (the web page has its own picker)
AGENT_LANGUAGE=en

# Optional: let callers talk over the assistant. Leave off on laptop speakers, where the
# assistant would hear its own voice; turn on if callers use headphones.
# ALLOW_INTERRUPTIONS=false

# Optional: CPU limits. Speech-to-text uses every thread it is given, which can slow the
# whole machine. STT_THREADS defaults to half the cores (max 6). In Docker, AGENT_CPUS
# (default 4) caps the agent container and sets STT_THREADS to match.
# STT_THREADS=4
# AGENT_CPUS=4
